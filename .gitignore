*.dmp
[Bb]ackup*/
[Ll]ogs/

# Local secrets
.env
.env.*
*.pfx
*.p12
*.key
*.pem

# Distribution archives and generated package inventory belong in Releases
*.zip
*.zip.sha256
/PACKAGE-MANIFEST.json
/publish/
/dist/


<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
  <AssemblyName>GugaLauncher</AssemblyName><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
  <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
 </PropertyGroup>
</Project>
